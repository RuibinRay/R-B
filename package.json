{
  "name": "rnb-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "R&B (Ray and Beat) — a browser music production studio",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test": "vitest run",
    "bench": "vitest run tests/benchmark.test.ts --reporter=verbose",
    "copy-model": "node scripts/copy-model.mjs",
    "fetch-samples": "node scripts/fetch-samples.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tonejs/midi": "^2.0.28",
    "immer": "^11.2.10",
    "lucide-react": "^1.72.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tone": "^15.1.22",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^3.2.7"
  }
}
